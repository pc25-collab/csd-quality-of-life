<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Topic 1 Learning Focus 2: Quality of Life Interactive Platform</title>
  
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          colors: {
            brand: {
              50: '#f0f7ff',
              100: '#e0effe',
              500: '#2563eb',
              600: '#1d4ed8',
              700: '#1e40af',
              800: '#1e3a8a',
            },
            accent: {
              500: '#f59e0b',
              600: '#d97706',
            }
          },
          fontFamily: {
            sans: ['Inter', 'sans-serif'],
          }
        }
      }
    }
  </script>

  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

  <!-- Vue.js 3 CDN -->
  <script src="https://unpkg.com/vue@3/dist/vue.global.js"></script>

  <!-- FontAwesome Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

  <!-- Chart.js CDN -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

  <style>
    [v-cloak] { display: none !important; }
    .card-flip { perspective: 1000px; }
    .card-inner { transition: transform 0.6s; transform-style: preserve-3d; }
    .card-flipped { transform: rotateY(180deg); }
    .card-front, .card-back { backface-visibility: hidden; }
    .card-back { transform: rotateY(180deg); }
    /* Custom scrollbars */
    ::-webkit-scrollbar { width: 6px; height: 6px; }
    ::-webkit-scrollbar-track { background: transparent; }
    ::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 9999px; }
    .dark ::-webkit-scrollbar-thumb { background: #475569; }
  </style>
</head>

<body class="h-full bg-slate-50 dark:bg-slate-900 text-slate-800 dark:text-slate-100 font-sans transition-colors duration-200">
  <div id="app" v-cloak class="min-h-screen flex flex-col">
    
    <!-- Top Navigation Header -->
    <header class="bg-white dark:bg-slate-800 border-b border-slate-200 dark:border-slate-700 sticky top-0 z-30 shadow-sm">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-16">
          <div class="flex items-center space-x-3">
            <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-blue-600 to-indigo-600 flex items-center justify-center text-white font-bold text-lg shadow-md shadow-blue-500/20">
              <i class="fa-solid fa-graduation-cap"></i>
            </div>
            <div>
              <h1 class="font-bold text-lg tracking-tight leading-none text-slate-900 dark:text-white">CSD Quality of Life</h1>
              <p class="text-xs text-slate-500 dark:text-slate-400">Topic 1 Learning Focus 2 • Interactive Platform</p>
            </div>
          </div>

          <!-- Desktop Navigation -->
          <nav class="hidden md:flex items-center space-x-1">
            <button 
              v-for="tab in mainTabs" 
              :key="tab.id"
              @click="activeTab = tab.id"
              :class="activeTab === tab.id 
                ? 'bg-blue-50 dark:bg-blue-900/40 text-blue-600 dark:text-blue-400 font-semibold' 
                : 'text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700/50'"
              class="px-3 py-2 rounded-lg text-sm transition flex items-center space-x-2">
              <i :class="tab.icon"></i>
              <span>{{ tab.name }}</span>
            </button>
          </nav>

          <!-- User Progress & Utilities -->
          <div class="flex items-center space-x-3">
            <div class="hidden sm:flex items-center space-x-2 bg-slate-100 dark:bg-slate-700/60 px-3 py-1.5 rounded-full text-xs font-medium">
              <i class="fa-solid fa-trophy text-amber-500"></i>
              <span>Progress: {{ overallProgress }}%</span>
            </div>

            <button @click="toggleDarkMode" class="p-2 rounded-lg text-slate-500 hover:bg-slate-100 dark:text-slate-400 dark:hover:bg-slate-700">
              <i class="fa-solid" :class="isDark ? 'fa-sun text-amber-400' : 'fa-moon'"></i>
            </button>

            <!-- Mobile Menu Toggle -->
            <button @click="mobileMenuOpen = !mobileMenuOpen" class="md:hidden p-2 rounded-lg text-slate-600 dark:text-slate-300">
              <i class="fa-solid" :class="mobileMenuOpen ? 'fa-xmark' : 'fa-bars'"></i>
            </button>
          </div>
        </div>
      </div>

      <!-- Mobile Dropdown Navigation -->
      <div v-if="mobileMenuOpen" class="md:hidden border-t border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-4 pt-2 pb-4 space-y-1">
        <button 
          v-for="tab in mainTabs" 
          :key="tab.id"
          @click="activeTab = tab.id; mobileMenuOpen = false"
          :class="activeTab === tab.id ? 'bg-blue-50 dark:bg-blue-900/40 text-blue-600 font-semibold' : 'text-slate-600 dark:text-slate-300'"
          class="w-full text-left px-3 py-2 rounded-lg text-base flex items-center space-x-3">
          <i :class="tab.icon" class="w-5 text-center"></i>
          <span>{{ tab.name }}</span>
        </button>
      </div>
    </header>

    <!-- Main Content Area -->
    <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6">
      
      <div v-if="activeTab === 'modules'" class="space-y-6">
        <!-- Module Header Banner -->
        <div class="bg-gradient-to-r from-blue-600 via-indigo-600 to-purple-600 rounded-2xl p-6 md:p-8 text-white shadow-xl relative overflow-hidden">
          <div class="absolute -right-10 -bottom-10 w-64 h-64 bg-white/10 rounded-full blur-2xl pointer-events-none"></div>
          <div class="relative z-10 max-w-3xl">
            <span class="inline-block bg-white/20 backdrop-blur-md text-xs font-semibold px-3 py-1 rounded-full uppercase tracking-wider mb-3">Topic 1 • Change in People's Life</span>
            <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight mb-2">Changes & Enhancement of People's Quality of Life</h2>
            <p class="text-blue-100 text-sm sm:text-base leading-relaxed">
              Explore how China's reform and opening-up transformed daily living standards across income, consumption patterns, educational levels, healthcare systems, and targeted poverty alleviation.
            </p>
            <div class="mt-4 flex flex-wrap gap-2 text-xs">
              <span class="bg-black/20 px-2.5 py-1 rounded-md"><i class="fa-solid fa-chart-line mr-1"></i> GDP & Per Capita Income</span>
              <span class="bg-black/20 px-2.5 py-1 rounded-md"><i class="fa-solid fa-shopping-bag mr-1"></i> Three Major Items</span>
              <span class="bg-black/20 px-2.5 py-1 rounded-md"><i class="fa-solid fa-graduation-cap mr-1"></i> Double Reduction</span>
              <span class="bg-black/20 px-2.5 py-1 rounded-md"><i class="fa-solid fa-heart-pulse mr-1"></i> Hierarchical Care</span>
              <span class="bg-black/20 px-2.5 py-1 rounded-md"><i class="fa-solid fa-hand-holding-hand mr-1"></i> Targeted Poverty Alleviation</span>
            </div>
          </div>
        </div>

        <!-- Section Navigation Grid -->
        <div class="grid grid-cols-2 md:grid-cols-5 gap-3">
          <button 
            v-for="(mod, idx) in modules" 
            :key="mod.id"
            @click="currentModuleIndex = idx"
            :class="currentModuleIndex === idx 
              ? 'ring-2 ring-blue-500 bg-white dark:bg-slate-800 shadow-md' 
              : 'bg-white/60 dark:bg-slate-800/60 hover:bg-white dark:hover:bg-slate-800'"
            class="p-3.5 rounded-xl border border-slate-200 dark:border-slate-700 text-left transition relative overflow-hidden group">
            <div class="flex items-center space-x-2 mb-1">
              <span class="w-6 h-6 rounded-lg flex items-center justify-center text-xs font-bold"
                :class="currentModuleIndex === idx ? 'bg-blue-600 text-white' : 'bg-slate-100 dark:bg-slate-700 text-slate-600 dark:text-slate-300'">
                {{ mod.letter }}
              </span>
              <span class="text-xs font-semibold text-slate-500 dark:text-slate-400">Section {{ idx + 1 }}</span>
            </div>
            <h3 class="text-xs sm:text-sm font-bold text-slate-900 dark:text-white line-clamp-2">{{ mod.title }}</h3>
          </button>
        </div>

        <!-- Active Module Content View -->
        <div class="bg-white dark:bg-slate-800 rounded-2xl border border-slate-200 dark:border-slate-700 p-6 md:p-8 shadow-sm space-y-8">
          
          <!-- Module Header -->
          <div class="flex flex-col md:flex-row md:items-center justify-between border-b border-slate-100 dark:border-slate-700/80 pb-6 gap-4">
            <div>
              <div class="flex items-center space-x-2 text-blue-600 dark:text-blue-400 font-bold text-xs uppercase tracking-wider mb-1">
                <i :class="activeModule.icon"></i>
                <span>Section {{ activeModule.letter }} Learning Module</span>
              </div>
              <h2 class="text-2xl font-bold text-slate-900 dark:text-white">{{ activeModule.title }}</h2>
              <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">{{ activeModule.subtitle }}</p>
            </div>
            <div class="flex items-center space-x-2">
              <button @click="prevModule" :disabled="currentModuleIndex === 0" class="px-3 py-1.5 rounded-lg border border-slate-200 dark:border-slate-700 text-xs font-medium hover:bg-slate-50 dark:hover:bg-slate-700 disabled:opacity-40">
                <i class="fa-solid fa-chevron-left mr-1"></i> Prev
              </button>
              <button @click="nextModule" :disabled="currentModuleIndex === modules.length - 1" class="px-3 py-1.5 rounded-lg bg-blue-600 hover:bg-blue-700 text-white text-xs font-medium disabled:opacity-40">
                Next <i class="fa-solid fa-chevron-right ml-1"></i>
              </button>
            </div>
          </div>

          <!-- Section A: Income Growth -->
          <div v-if="activeModule.id === 'income'" class="space-y-8">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
              <div class="space-y-4">
                <h3 class="text-lg font-bold text-slate-900 dark:text-white flex items-center">
                  <i class="fa-solid fa-arrow-trend-up text-blue-500 mr-2"></i> 1. Sharp Increase in Income & GDP
                </h3>
                <p class="text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
                  The international community uses Gross Domestic Product (GDP) and per capita GDP to measure economic levels. Since reform and opening-up, China's economic output has surged drastically.
                </p>
                
                <div class="grid grid-cols-2 gap-3 pt-2">
                  <div class="bg-blue-50 dark:bg-blue-950/40 border border-blue-100 dark:border-blue-900/50 p-4 rounded-xl">
                    <span class="text-xs text-blue-600 dark:text-blue-400 font-semibold block uppercase">1978 Per Capita GDP</span>
                    <span class="text-2xl font-extrabold text-blue-900 dark:text-blue-200">RMB 385</span>
                  </div>
                  <div class="bg-emerald-50 dark:bg-emerald-950/40 border border-emerald-100 dark:border-emerald-900/50 p-4 rounded-xl">
                    <span class="text-xs text-emerald-600 dark:text-emerald-400 font-semibold block uppercase">2024 Per Capita GDP</span>
                    <span class="text-2xl font-extrabold text-emerald-900 dark:text-emerald-200">RMB 95,749</span>
                    <span class="text-xs text-emerald-600 block mt-1"><i class="fa-solid fa-arrow-up"></i> ~249x Increase</span>
                  </div>
                </div>

                <div class="bg-slate-50 dark:bg-slate-700/40 p-4 rounded-xl border border-slate-200 dark:border-slate-700">
                  <h4 class="text-xs font-bold text-slate-700 dark:text-slate-200 uppercase tracking-wider mb-2">Key Definition: Per Capita Disposable Income</h4>
                  <p class="text-xs text-slate-600 dark:text-slate-300">
                    The income actually available for daily living expenses and savings after deducting taxes and social security contributions from total household income.
                  </p>
                </div>
              </div>

              <!-- Interactive Chart Container -->
              <div class="bg-slate-50 dark:bg-slate-900/60 p-4 rounded-2xl border border-slate-200 dark:border-slate-700">
                <div class="flex items-center justify-between mb-3">
                  <h4 class="text-xs font-bold text-slate-700 dark:text-slate-300 uppercase">Per Capita GDP Growth Trend (RMB)</h4>
                  <span class="text-xs bg-blue-100 dark:bg-blue-900/60 text-blue-700 dark:text-blue-300 px-2 py-0.5 rounded font-mono">1978 - 2024</span>
                </div>
                <div class="h-64 relative">
                  <canvas id="gdpChart"></canvas>
                </div>
              </div>
            </div>

            <!-- Gini Coefficient & Wealth Gap -->
            <div class="border-t border-slate-200 dark:border-slate-700 pt-6 space-y-4">
              <h3 class="text-lg font-bold text-slate-900 dark:text-white flex items-center">
                <i class="fa-solid fa-scale-unbalanced text-amber-500 mr-2"></i> 2. Wealth Concentration & Gini Coefficient
              </h3>
              <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                <div class="bg-amber-50 dark:bg-amber-950/30 border border-amber-200 dark:border-amber-900/40 p-4 rounded-xl">
                  <h4 class="font-bold text-amber-900 dark:text-amber-200 text-sm mb-1">Gini Warning Line (0.4)</h4>
                  <p class="text-xs text-amber-800 dark:text-amber-300">
                    Although China's Gini coefficient has shown an overall decreasing trend in recent years, it continues to hover above the international warning threshold of 0.4, reflecting ongoing income disparity.
                  </p>
                </div>

                <div class="bg-indigo-50 dark:bg-indigo-950/30 border border-indigo-200 dark:border-indigo-900/40 p-4 rounded-xl">
                  <h4 class="font-bold text-indigo-900 dark:text-indigo-200 text-sm mb-1">Urban-Rural Disparity</h4>
                  <p class="text-xs text-indigo-800 dark:text-indigo-300">
                    The income gap between urban and rural residents dropped from a peak of 3.3 times in 2009 down to 2.34 times in 2024 as rural development policies took effect.
                  </p>
                </div>

                <div class="bg-purple-50 dark:bg-purple-950/30 border border-purple-200 dark:border-purple-900/40 p-4 rounded-xl">
                  <h4 class="font-bold text-purple-900 dark:text-purple-200 text-sm mb-1">Western Development Strategy</h4>
                  <p class="text-xs text-purple-800 dark:text-purple-300">
                    Launched in 2001 and reinforced by the Belt & Road Initiative (2013) to bridge coastal-inland regional disparities through infrastructure (e.g. South-to-North Water Transfer), energy, and education.
                  </p>
                </div>
              </div>
            </div>
          </div>

          <!-- Section B: Consumption Patterns -->
          <div v-if="activeModule.id === 'consumption'" class="space-y-8">
            <!-- Three Major Items Evolution Timeline -->
            <div class="space-y-4">
              <h3 class="text-lg font-bold text-slate-900 dark:text-white flex items-center">
                <i class="fa-solid fa-boxes-packing text-indigo-500 mr-2"></i> Evolution of the "Three Major Items" (三大件)
              </h3>
              <p class="text-sm text-slate-600 dark:text-slate-300">
                The evolution of essential household items over decades reflects rising income levels and the shift from basic living security to quality and hedonic consumption.
              </p>

              <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                <div class="border border-slate-200 dark:border-slate-700 rounded-xl p-4 bg-slate-50 dark:bg-slate-900/40">
                  <div class="flex items-center justify-between mb-2">
                    <span class="text-xs font-bold text-blue-600 dark:text-blue-400 uppercase">Late 1970s</span>
                    <i class="fa-solid fa-bicycle text-slate-400"></i>
                  </div>
                  <h4 class="font-bold text-sm text-slate-900 dark:text-white mb-2">Basic Durables</h4>
                  <ul class="text-xs text-slate-600 dark:text-slate-300 space-y-1">
                    <li>• Bicycle (腳踏車)</li>
                    <li>• Wristwatch (手錶)</li>
                    <li>• Sewing Machine (縫纫機)</li>
                  </ul>
                </div>

                <div class="border border-slate-200 dark:border-slate-700 rounded-xl p-4 bg-slate-50 dark:bg-slate-900/40">
                  <div class="flex items-center justify-between mb-2">
                    <span class="text-xs font-bold text-indigo-600 dark:text-indigo-400 uppercase">1980s</span>
                    <i class="fa-solid fa-tv text-slate-400"></i>
                  </div>
                  <h4 class="font-bold text-sm text-slate-900 dark:text-white mb-2">Home Electricals</h4>
                  <ul class="text-xs text-slate-600 dark:text-slate-300 space-y-1">
                    <li>• Color TV (彩電)</li>
                    <li>• Refrigerator (雪櫃)</li>
                    <li>• Washing Machine (洗衣機)</li>
                  </ul>
                </div>

                <div class="border border-slate-200 dark:border-slate-700 rounded-xl p-4 bg-slate-50 dark:bg-slate-900/40">
                  <div class="flex items-center justify-between mb-2">
                    <span class="text-xs font-bold text-purple-600 dark:text-purple-400 uppercase">1990s</span>
                    <i class="fa-solid fa-fan text-slate-400"></i>
                  </div>
                  <h4 class="font-bold text-sm text-slate-900 dark:text-white mb-2">Modern Comforts</h4>
                  <ul class="text-xs text-slate-600 dark:text-slate-300 space-y-1">
                    <li>• Air Conditioner (冷氣機)</li>
                    <li>• VCD/DVD Player</li>
                    <li>• Mobile Phone / Computer</li>
                  </ul>
                </div>

                <div class="border border-slate-200 dark:border-slate-700 rounded-xl p-4 bg-slate-50 dark:bg-slate-900/40">
                  <div class="flex items-center justify-between mb-2">
                    <span class="text-xs font-bold text-emerald-600 dark:text-emerald-400 uppercase">2000s Onwards</span>
                    <i class="fa-solid fa-car text-slate-400"></i>
                  </div>
                  <h4 class="font-bold text-sm text-slate-900 dark:text-white mb-2">Asset & Upgrade</h4>
                  <ul class="text-xs text-slate-600 dark:text-slate-300 space-y-1">
                    <li>• Private Housing (住房)</li>
                    <li>• Private Automobiles (汽車)</li>
                    <li>• Children's Education (子女教育)</li>
                  </ul>
                </div>
              </div>
            </div>

            <!-- E-Commerce & Class Consumption Features -->
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 pt-4 border-t border-slate-200 dark:border-slate-700">
              <div class="space-y-4">
                <h3 class="text-lg font-bold text-slate-900 dark:text-white flex items-center">
                  <i class="fa-solid fa-mobile-screen-button text-emerald-500 mr-2"></i> Electronic & Modern Consumption
                </h3>
                <p class="text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
                  Online payments reached <span class="font-bold text-emerald-600 dark:text-emerald-400">1.029 billion users in 2024</span>. Platforms such as Alibaba, JD.com, and Pinduoduo drive cross-border and domestic e-commerce expansion.
                </p>
                <div class="bg-emerald-50 dark:bg-emerald-950/30 border border-emerald-200 dark:border-emerald-900/40 p-4 rounded-xl text-xs space-y-2">
                  <div class="font-bold text-emerald-900 dark:text-emerald-200">Key Consumption Concepts:</div>
                  <p class="text-emerald-800 dark:text-emerald-300">• <strong>Hedonic Consumption (享樂型消費):</strong> Spending focused on personalized enjoyment, leisure, and psychological satisfaction.</p>
                  <p class="text-emerald-800 dark:text-emerald-300">• <strong>Generation Z Trends:</strong> Emphasis on self-expression, interest-driven spending, and live commerce.</p>
                </div>
              </div>

              <!-- Social Class Consumption Features -->
              <div class="space-y-3">
                <h3 class="text-lg font-bold text-slate-900 dark:text-white flex items-center">
                  <i class="fa-solid fa-users text-blue-500 mr-2"></i> Class Consumption Features
                </h3>
                <div class="space-y-2 text-xs">
                  <div class="p-3 bg-slate-50 dark:bg-slate-700/40 rounded-xl border border-slate-200 dark:border-slate-700">
                    <span class="font-bold text-blue-600 dark:text-blue-400">Upper Class:</span> Values wealth growth, investments (gold, stocks, funds), international travel, luxury items, and children's premium education.
                  </div>
                  <div class="p-3 bg-slate-50 dark:bg-slate-700/40 rounded-xl border border-slate-200 dark:border-slate-700">
                    <span class="font-bold text-indigo-600 dark:text-indigo-400">Middle Class:</span> Higher educated; pursues lifestyle quality, leisure activities, health wellness, and high priority on children's education.
                  </div>
                  <div class="p-3 bg-slate-50 dark:bg-slate-700/40 rounded-xl border border-slate-200 dark:border-slate-700">
                    <span class="font-bold text-slate-600 dark:text-slate-400">Lower Class:</span> Focuses mainly on essential living needs (food, clothing) with limited disposable funds for discretionary entertainment.
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Section C: Education -->
          <div v-if="activeModule.id === 'education'" class="space-y-8">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
              <div class="space-y-4">
                <h3 class="text-lg font-bold text-slate-900 dark:text-white flex items-center">
                  <i class="fa-solid fa-graduation-cap text-purple-500 mr-2"></i> 1. Expansion of Gross Enrolment Rates
                </h3>
                <p class="text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
                  Implementation of 9-year compulsory education (1986) and massive higher education expansion since 1998 resulted in significant national human capital enhancement.
                </p>

                <div class="space-y-3 text-xs">
                  <div class="flex justify-between items-center p-3 bg-slate-50 dark:bg-slate-900/40 rounded-xl border border-slate-200 dark:border-slate-700">
                    <span class="font-medium">Junior Secondary Gross Enrolment</span>
                    <span class="font-mono font-bold text-slate-900 dark:text-white">80% (1995) → <span class="text-purple-600 dark:text-purple-400">102.5% (2020)</span></span>
                  </div>
                  <div class="flex justify-between items-center p-3 bg-slate-50 dark:bg-slate-900/40 rounded-xl border border-slate-200 dark:border-slate-700">
                    <span class="font-medium">Senior Secondary Gross Enrolment</span>
                    <span class="font-mono font-bold text-slate-900 dark:text-white">26% (1990) → <span class="text-purple-600 dark:text-purple-400">92% (2024)</span></span>
                  </div>
                  <div class="flex justify-between items-center p-3 bg-slate-50 dark:bg-slate-900/40 rounded-xl border border-slate-200 dark:border-slate-700">
                    <span class="font-medium">Higher Education Enrolment</span>
                    <span class="font-mono font-bold text-slate-900 dark:text-white">3.4% (1990) → <span class="text-purple-600 dark:text-purple-400">60.8% (2024)</span></span>
                  </div>
                </div>

                <div class="bg-purple-50 dark:bg-purple-950/30 border border-purple-200 dark:border-purple-900/40 p-4 rounded-xl text-xs">
                  <span class="font-bold text-purple-900 dark:text-purple-200 block mb-1">Fiscal Funding Commitment (4% GDP Target)</span>
                  <p class="text-purple-800 dark:text-purple-300">
                    Since 2012, government fiscal spending on education has consistently remained above 4% of total GDP, reaching RMB 6,459.5 billion in 2023.
                  </p>
                </div>
              </div>

              <!-- Education Chart -->
