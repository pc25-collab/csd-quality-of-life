      <div v-if="activeTab === 'aiTutor'" class="space-y-6">
        <div class="bg-white dark:bg-slate-800 p-6 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-sm">
          <div class="flex items-center space-x-3">
            <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-purple-600 to-pink-600 flex items-center justify-center text-white text-lg font-bold shadow-md">
              <i class="fa-solid fa-robot"></i>
            </div>
            <div>
              <h2 class="text-xl font-bold text-slate-900 dark:text-white">Gemini AI Curriculum Assistant</h2>
              <p class="text-xs text-slate-500 dark:text-slate-400">Ask any CSD question regarding Quality of Life, Gini coefficient, Double Reduction, or Poverty Alleviation.</p>
            </div>
          </div>
        </div>

        <div class="bg-white dark:bg-slate-800 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-sm h-[500px] flex flex-col">
          <!-- Chat Log -->
          <div class="flex-1 p-6 overflow-y-auto space-y-4" id="chatContainer">
            <div v-for="(msg, mIdx) in chatMessages" :key="mIdx" :class="msg.role === 'user' ? 'justify-end' : 'justify-start'" class="flex">
              <div :class="msg.role === 'user' ? 'bg-blue-600 text-white rounded-2xl rounded-tr-none' : 'bg-slate-100 dark:bg-slate-700/80 text-slate-800 dark:text-slate-100 rounded-2xl rounded-tl-none'" class="max-w-[80%] p-4 text-xs sm:text-sm leading-relaxed space-y-2">
                <div class="font-bold text-[10px] opacity-70 uppercase mb-1">{{ msg.role === 'user' ? 'You' : 'Gemini CSD Tutor' }}</div>
                <p class="whitespace-pre-line">{{ msg.text }}</p>
              </div>
            </div>
            <div v-if="aiLoading" class="flex justify-start">
              <div class="bg-slate-100 dark:bg-slate-700 p-3 rounded-2xl text-xs text-slate-500 flex items-center space-x-2">
                <i class="fa-solid fa-spinner fa-spin"></i>
                <span>Gemini is generating response...</span>
              </div>
            </div>
          </div>

          <!-- Chat Input -->
          <div class="p-4 border-t border-slate-200 dark:border-slate-700 flex gap-2">
            <input 
              v-model="userQuery" 
              @keyup.enter="sendAiMessage"
              type="text" 
              placeholder="e.g. How does the Western Development Strategy narrow regional income disparities?" 
              class="flex-1 bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-xl px-4 py-2 text-xs sm:text-sm outline-none focus:ring-2 focus:ring-blue-500">
            <button @click="sendAiMessage" :disabled="aiLoading || !userQuery.trim()" class="px-5 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-xl font-semibold text-xs transition disabled:opacity-50">
              Send <i class="fa-solid fa-paper-plane ml-1"></i>
            </button>
          </div>
        </div>
      </div>

      <div v-if="activeTab === 'github'" class="space-y-6">
        <div class="bg-white dark:bg-slate-800 p-6 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-sm space-y-4">
          <div class="flex items-center space-x-3">
            <div class="w-10 h-10 rounded-xl bg-slate-900 dark:bg-slate-700 text-white flex items-center justify-center text-xl">
              <i class="fa-brands fa-github"></i>
            </div>
            <div>
              <h2 class="text-xl font-bold text-slate-900 dark:text-white">Publish to GitHub Pages Instructions</h2>
              <p class="text-xs text-slate-500 dark:text-slate-400">Follow these simple steps to host this interactive teaching platform for free on GitHub.</p>
            </div>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-4 pt-2 text-xs">
            <div class="p-4 bg-slate-50 dark:bg-slate-900/40 rounded-xl border border-slate-200 dark:border-slate-700 space-y-2">
              <div class="font-bold text-blue-600 dark:text-blue-400 text-sm">Step 1: Save Code</div>
              <p class="text-slate-600 dark:text-slate-300">Copy the code from this editor window and save it locally as <code>index.html</code>.</p>
            </div>

            <div class="p-4 bg-slate-50 dark:bg-slate-900/40 rounded-xl border border-slate-200 dark:border-slate-700 space-y-2">
              <div class="font-bold text-blue-600 dark:text-blue-400 text-sm">Step 2: Create Repository</div>
              <p class="text-slate-600 dark:text-slate-300">Create a new public repository on <a href="https://github.com" target="_blank" class="underline text-blue-500">GitHub.com</a> (e.g. <code>csd-quality-of-life</code>).</p>
            </div>

            <div class="p-4 bg-slate-50 dark:bg-slate-900/40 rounded-xl border border-slate-200 dark:border-slate-700 space-y-2">
              <div class="font-bold text-blue-600 dark:text-blue-400 text-sm">Step 3: Enable Pages</div>
              <p class="text-slate-600 dark:text-slate-300">Upload <code>index.html</code>, go to Repo <strong>Settings → Pages</strong>, select <code>main</code> branch, and save!</p>
            </div>
          </div>

          <!-- Generated README Box -->
          <div class="space-y-2 border-t border-slate-100 dark:border-slate-700 pt-4">
            <label class="text-xs font-bold text-slate-700 dark:text-slate-300 flex justify-between items-center">
              <span>Suggested GitHub README.md:</span>
              <button @click="copyReadme" class="text-blue-600 dark:text-blue-400 hover:underline text-xs"><i class="fa-solid fa-copy mr-1"></i> Copy README</button>
            </label>
            <pre class="bg-slate-900 text-slate-200 p-4 rounded-xl text-xs overflow-x-auto font-mono leading-relaxed">{{ generatedReadme }}</pre>
          </div>
        </div>
      </div>

    </main>

    <!-- Footer -->
    <footer class="bg-white dark:bg-slate-800 border-t border-slate-200 dark:border-slate-700 py-4 text-center text-xs text-slate-500">
      <p>Citizenship & Social Development • Topic 1 Learning Focus 2 Teaching Platform</p>
    </footer>
  </div>

  <script>
    const { createApp, ref, computed, onMounted, nextTick, watch } = Vue;

    createApp({
      setup() {
        const isDark = ref(false);
        const activeTab = ref('modules');
        const mobileMenuOpen = ref(false);
        const currentModuleIndex = ref(0);
        const flashcardFilter = ref('ALL');
        const activeIssueIndex = ref(0);
        const studentResponse = ref('');
        const showModelAnswer = ref(false);
        const userAnswers = ref({});
        const userQuery = ref('');
        const aiLoading = ref(false);

        const chatMessages = ref([
          { role: 'model', text: 'Hello! I am your CSD AI Study Assistant. You can ask me anything regarding Quality of Life, Gini coefficient, consumption trends, education reforms, or poverty alleviation.' }
        ]);

        const mainTabs = [
          { id: 'modules', name: 'Learning Modules', icon: 'fa-solid fa-book-open' },
          { id: 'quiz', name: 'Quizzes', icon: 'fa-solid fa-circle-question' },
          { id: 'flashcards', name: 'Key Terms', icon: 'fa-solid fa-layer-group' },
          { id: 'exam', name: 'Exam Simulator', icon: 'fa-solid fa-pen-to-square' },
          { id: 'aiTutor', name: 'AI Tutor', icon: 'fa-solid fa-robot' },
          { id: 'github', name: 'GitHub Guide', icon: 'fa-brands fa-github' }
        ];

        const modules = [
          { id: 'income', letter: 'A', title: 'Increase in Income & Wealth Distribution', subtitle: 'GDP growth, Per Capita Disposable Income, Gini Coefficient & Disparities', icon: 'fa-solid fa-arrow-trend-up' },
          { id: 'consumption', letter: 'B', title: 'Changes in Consumption Patterns', subtitle: 'Three Major Items, Hedonic Consumption, Gen Z & E-Commerce', icon: 'fa-solid fa-shopping-bag' },
          { id: 'education', letter: 'C', title: 'Advancement of Education', subtitle: 'Enrolment Rates, Fiscal Investment & The Double Reduction Policy', icon: 'fa-solid fa-graduation-cap' },
          { id: 'healthcare', letter: 'D', title: 'Improvement in Healthcare', subtitle: 'Universal Medical Insurance, Hierarchical Care & Health Metrics', icon: 'fa-solid fa-heart-pulse' },
          { id: 'poverty', letter: 'E', title: 'Practice of Targeted Poverty Alleviation', subtitle: 'Two Assurances Three Guarantees, Infrastructure & Global SDGs', icon: 'fa-solid fa-hand-holding-hand' }
        ];

        const activeModule = computed(() => modules[currentModuleIndex.value]);

        const quizzes = [
          {
            id: 1,
            category: 'Income Strategies',
            question: 'Which of the following is NOT part of the Government\'s strategies to protect the disadvantaged?',
            options: ['A. Pension systems in urban/rural regions', 'B. Social medical insurance', 'C. Coordinated regional development', 'D. Food allowance'],
            correct: 3,
            explanation: 'Food allowance is not listed as part of the core national institutional social security framework (PPT Slide 19).'
          },
          {
            id: 2,
            category: 'Consumption Patterns',
            question: 'Which of the following was NOT one of the "Three Major Items" in the early 2000s?',
            options: ['A. Housing', 'B. Watch', 'C. Automobiles', 'D. Children\'s Education'],
            correct: 1,
            explanation: 'The wrist watch was a major item in the late 1970s, not the early 2000s when housing, cars, and education took precedence (PPT Slide 30).'
          },
          {
            id: 3,
            category: 'Education Policy',
            question: 'Which of the following is NOT part of China\'s official national education policy framework?',
            options: ['A. Nine-year free compulsory education', 'B. Exemption on rural tuition/miscellaneous fees', 'C. Rural teachers\' subsistence allowance', 'D. Free university tuition for all'],
            correct: 3,
            explanation: 'Universal free university tuition is not provided; higher education has been expanded and popularized, but remains fee-paying with student financial aid (PPT Slide 61).'
          },
          {
            id: 4,
            category: 'Healthcare System',
            question: 'Which statement accurately describes the core target of China\'s Hierarchical Medical System?',
            options: [
              'A. Treat serious illnesses in community clinics, cure minor in hospitals.',
              'B. Treat minor illnesses in community medical institutions, cure serious illnesses in tertiary hospitals, and recover back in community medical institutions.',
              'C. Treat minor illnesses at home and severe conditions in clinics.',
              'D. Treat all patients exclusively in central tier-1 city hospitals.'
            ],
            correct: 1,
            explanation: 'The hierarchical pattern aims for "minor illnesses in community clinics, serious illnesses in tertiary hospitals, and recovery back in community facilities" (PPT Slide 86).'
          },
          {
            id: 5,
            category: 'Poverty Alleviation',
            question: 'Which of the following is NOT one of the specialized measures implemented for rural poverty alleviation?',
            options: ['A. Poverty alleviation by developing transport', 'B. Poverty alleviation by developing industries', 'C. Poverty alleviation through drinking water rationing', 'D. Poverty alleviation through e-commerce'],
            correct: 2,
            explanation: 'Drinking water rationing was not a designated poverty eradication pillar strategy (PPT Slide 98).'
          }
        ];

        const flashcards = ref([
          { id: 1, category: 'Income', termEn: 'Gini Coefficient', termZh: '基尼系數', definition: 'A numerical measure of income inequality ranging from 0 to 1. In China, despite overall declining trends, it remains above the 0.4 international warning threshold.', flipped: false },
          { id: 2, category: 'Income', termEn: 'Western Development Strategy', termZh: '西部大開發', definition: 'Central policy initiated in 2001 to bridge economic, infrastructure, and educational gaps between prosperous coastal cities and inland western regions.', flipped: false },
          { id: 3, category: 'Consumption', termEn: 'Three Major Items', termZh: '三大件', definition: 'Symbolic benchmark consumer durables reflecting living standards across decades (e.g. 1970s bicycle/watch vs 2000s housing/automobile/education).', flipped: false },
          { id: 4, category: 'Consumption', termEn: 'Hedonic Consumption', termZh: '享樂型消費', definition: 'Purchasing behavior focused on personal enjoyment, leisure, lifestyle satisfaction, and emotional fulfillment rather than mere survival necessities.', flipped: false },
          { id: 5, category: 'Education', termEn: 'Double Reduction Policy', termZh: '雙減政策', definition: 'Policy enacted to ease student academic stress by capping homework volume and banning profit-making off-campus academic tutoring.', flipped: false },
          { id: 6, category: 'Healthcare', termEn: 'Hierarchical Medical System', termZh: '分級診療制度', definition: 'Healthcare structure directing minor illnesses to primary community clinics and serious conditions to major tertiary hospitals.', flipped: false },
          { id: 7, category: 'Poverty', termEn: 'Targeted Poverty Alleviation', termZh: '精準扶貧', definition: 'Strategy proposed by Xi Jinping in 2013 providing tailored relief according to local conditions rather than generic aid.', flipped: false },
          { id: 8, category: 'Poverty', termEn: 'Two Assurances & Three Guarantees', termZh: '兩不愁三保障', definition: 'Assurances of adequate food and clothing; guarantees of compulsory education, basic medical care, and safe housing.', flipped: false }
        ]);

        const filteredFlashcards = computed(() => {
          if (flashcardFilter.value === 'ALL') return flashcards.value;
          return flashcards.value.filter(c => c.category === flashcardFilter.value);
        });

        const issueAnalyses = [
          {
            id: 1,
            topic: 'Issue Analysis 1: Impact of Online Shopping & Over-Consumption',
            sources: {
              srcA: { title: 'Source A: Saving Habits by Age Group', content: 'Survey data shows 59.88% of respondents aged 40-50 do not save, whereas 50.43% of elderly (70-100) maintain strict savings behavior.' },
              srcB: { title: 'Source B: Consumer Psychology of Youth', content: 'Live commerce and promotional festivals encourage young shoppers to spend in advance for immediate enjoyment.' },
              srcC: { title: 'Source C: University Student Financial Health', content: 'Convenient online credit loans lead over 53% of university students to spend beyond their means, accumulating debts.' }
            },
            question: {
              prompt: 'What challenges does online shopping bring to Chinese society? Explain your answer with reference to the sources and your own knowledge.',
              marks: 6,
              keyPoints: [
                'Fostering an excessive materialist consumption atmosphere that strains individual financial health.',
                'Engendering debt burdens and psychological stress among university students and young people.',
                'Impacting long-term social positivity and values when financial management skills are lacking.'
              ],
              modelAnswer: `Firstly, online shopping fosters an excessive consumption atmosphere, posing a challenge to Chinese society. As shown in Source B, ubiquitous promotions like live commerce increase young consumers' desire to shop and spend in advance for immediate gratification. While this boosts short-term economic activity, over-emphasizing consumerism can weaken traditional values of prudence and thrift.

Secondly, online shopping brings debt risks and mental pressure to adolescents. According to Source C, over 53% of university students borrow money for shopping beyond their means due to easy access to e-commerce credit lines. Prolonged indebtedness places heavy psychological burdens on youth, dampening their long-term life positivity and societal vitality.`
            }
          },
          {
            id: 2,
            topic: 'Issue Analysis 2: Educational Reform & The "Double Reduction" Policy',
            sources: {
              srcA: { title: 'Source A: Off-Campus Tutoring Participation Rates', content: 'Senior secondary tutoring participation is highest at 51.9% due to public exam pressure; primary students join mostly interest classes (27.9%).' },
              srcB: { title: 'Source B: Central Double Reduction Directives', content: 'Curbs homework duration, strictly forbids profit-making off-campus academic tutoring, and addresses manufactured academic anxiety.' }
            },
            question: {
              prompt: '"The Double Reduction policy can relieve students\' study pressure and improve the learning environment." How do the sources support this view?',
              marks: 6,
              keyPoints: [
                'Balancing student life by capping homework and freeing leisure time for holistic development.',
                'Cracking down on unscrupulous tutoring institutions that manufacture academic anxiety for commercial profit.',
                'Restoring fairness and core educational purpose within public schools.'
              ],
              modelAnswer: `Firstly, the policy gives students a balanced life by directly reducing excessive study pressure. Source A indicates that over half (51.9%) of senior secondary students attend off-campus academic tutoring, leaving little rest time. By strictly regulating homework caps, Double Reduction restores personal time for extra-curricular interests and healthy social growth.

Secondly, the policy cracks down on commercialized tutoring institutions that artificially amplify social anxiety. Source B shows the Central Authorities rectified tutoring chaos where private firms manufactured exam panic for profit. By eliminating profit-driven academic tutoring, the learning environment returns to its original purpose: fostering well-rounded, healthy citizens.`
            }
          }
        ];

        const currentIssue = computed(() => issueAnalyses[activeIssueIndex.value]);

        const quizScore = computed(() => {
          let score = 0;
          quizzes.forEach(q => {
            if (userAnswers.value[q.id] === q.correct) score++;
          });
          return score;
        });

        const overallProgress = computed(() => {
          const quizCount = Object.keys(userAnswers.value).length;
          const totalQuizzes = quizzes.length;
          const ratio = (quizCount / totalQuizzes) * 100;
          return Math.round(ratio);
        });

        function selectAnswer(qId, optIdx) {
          userAnswers.value[qId] = optIdx;
        }

        function getOptionClass(q, optIdx) {
          const selected = userAnswers.value[q.id];
          if (selected === undefined) {
            return 'bg-slate-50 dark:bg-slate-700/50 hover:bg-slate-100 dark:hover:bg-slate-700 border-slate-200 dark:border-slate-600';
          }
          if (optIdx === q.correct) {
            return 'bg-emerald-100 dark:bg-emerald-950/60 border-emerald-500 font-bold text-emerald-900 dark:text-emerald-200';
          }
          if (selected === optIdx && optIdx !== q.correct) {
            return 'bg-rose-100 dark:bg-rose-950/60 border-rose-500 font-bold text-rose-900 dark:text-rose-200';
          }
          return 'bg-slate-50 dark:bg-slate-800 opacity-50 border-slate-200 dark:border-slate-700';
        }

        function resetQuiz() {
          userAnswers.value = {};
        }

        function prevModule() {
          if (currentModuleIndex.value > 0) currentModuleIndex.value--;
        }

        function nextModule() {
          if (currentModuleIndex.value < modules.length - 1) currentModuleIndex.value++;
        }

        function toggleDarkMode() {
          isDark.value = !isDark.value;
          if (isDark.value) {
            document.documentElement.classList.add('dark');
          } else {
            document.documentElement.classList.remove('dark');
          }
        }

        async function sendAiMessage() {
          if (!userQuery.value.trim() || aiLoading.value) return;
          const qText = userQuery.value.trim();
          chatMessages.value.push({ role: 'user', text: qText });
          userQuery.value = '';
          aiLoading.value = true;

          try {
            const systemPrompt = "You are an expert Hong Kong CSD (Citizenship & Social Development) curriculum tutor specializing in Topic 1 Learning Focus 2: Quality of Life in China. Answer concisely, using structured bullet points and academic CSD terminology.";
            const apiKey = "";
            const apiUrl = `https://generativelanguage.googleapis.com/v1beta/models/gemini-3-flash-preview:generateContent?key=${apiKey}`;

            const response = await fetch(apiUrl, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                contents: [{ parts: [{ text: qText }] }],
                systemInstruction: { parts: [{ text: systemPrompt }] }
              })
            });

            const result = await response.json();
            const reply = result?.candidates?.[0]?.content?.parts?.[0]?.text || "Sorry, I could not generate a response. Please try again.";
            chatMessages.value.push({ role: 'model', text: reply });
          } catch (err) {
            chatMessages.value.push({ role: 'model', text: 'Error contacting AI assistant. Please check network connection.' });
          } finally {
            aiLoading.value = false;
            nextTick(() => {
              const el = document.getElementById('chatContainer');
              if (el) el.scrollTop = el.scrollHeight;
            });
          }
        }

        const generatedReadme = `# CSD Quality of Life Interactive Platform

Interactive educational platform for Citizenship & Social Development (Topic 1 Learning Focus 2: Changes and Enhancement of People's Quality of Life).

## Features
- **Interactive Curriculum Modules**: Income, Consumption, Education, Healthcare, and Poverty Alleviation.
- **Data Visualizations**: Built with Chart.js showing per capita GDP growth and higher education enrolment trends.
- **Knowledge Check Quizzes**: Interactive questions with explanations directly from PPT slides.
- **Exam Simulator**: Guided source analysis with model answers and rubric breakdowns.
- **Flashcard Hub**: Official English/Chinese definitions for curriculum key terms.
- **Gemini AI Tutor**: Integrated study assistant for custom Q&A.

## Live Demo
Hosted via GitHub Pages!`;

        function copyReadme() {
          const el = document.createElement('textarea');
          el.value = generatedReadme;
          document.body.appendChild(el);
          el.select();
          document.execCommand('copy');
          document.body.removeChild(el);
          alert('README copied to clipboard!');
        }

        // Chart Initialization
        let gdpChartInst = null;
        let eduChartInst = null;

        function initCharts() {
          nextTick(() => {
            const gdpCtx = document.getElementById('gdpChart');
            if (gdpCtx) {
              if (gdpChartInst) gdpChartInst.destroy();
              gdpChartInst = new Chart(gdpCtx, {
                type: 'line',
                data: {
                  labels: ['1978', '1990', '2000', '2010', '2020', '2024'],
                  datasets: [{
                    label: 'Per Capita GDP (RMB)',
                    data: [385, 1663, 7942, 30808, 71828, 95749],
                    borderColor: '#2563eb',
                    backgroundColor: 'rgba(37, 99, 235, 0.1)',
                    fill: true,
                    tension: 0.3
                  }]
                },
                options: {
                  responsive: true,
                  maintainAspectRatio: false,
                  plugins: { legend: { display: false } },
                  scales: { y: { beginAtZero: true } }
                }
              });
            }

            const eduCtx = document.getElementById('educationChart');
            if (eduCtx) {
              if (eduChartInst) eduChartInst.destroy();
              eduChartInst = new Chart(eduCtx, {
                type: 'bar',
                data: {
                  labels: ['1990', '2000', '2010', '2020', '2024'],
                  datasets: [{
                    label: 'Gross Higher Ed Enrolment (%)',
                    data: [3.4, 12.5, 26.5, 54.4, 60.8],
                    backgroundColor: '#8b5cf6',
                    borderRadius: 8
                  }]
                },
                options: {
                  responsive: true,
                  maintainAspectRatio: false,
                  plugins: { legend: { display: false } },
                  scales: { y: { beginAtZero: true, max: 100 } }
                }
              });
            }
          });
        }

        watch(currentModuleIndex, () => {
          initCharts();
        });

        watch(activeTab, (newTab) => {
          if (newTab === 'modules') {
            initCharts();
          }
        });

        onMounted(() => {
          initCharts();
        });

        return {
          isDark,
          activeTab,
          mainTabs,
          mobileMenuOpen,
          modules,
          currentModuleIndex,
          activeModule,
          quizzes,
          userAnswers,
          selectAnswer,
          getOptionClass,
          resetQuiz,
          quizScore,
          overallProgress,
          flashcards,
          flashcardFilter,
          filteredFlashcards,
          issueAnalyses,
          activeIssueIndex,
          currentIssue,
          studentResponse,
          showModelAnswer,
          userQuery,
          chatMessages,
          aiLoading,
          sendAiMessage,
          prevModule,
          nextModule,
          toggleDarkMode,
          generatedReadme,
          copyReadme
        };
      }
    }).mount('#app');
  </script>
</body>
</html>
